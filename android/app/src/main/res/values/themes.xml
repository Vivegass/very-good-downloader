<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Окно до первого кадра Compose; цвета экрана — из MaterialTheme (Material You / тема с ПК). -->
    <style name="Theme.Vgd" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <!-- «Поделиться» и плитка: экран не виден, только ставит ссылку в очередь. -->
    <style name="Theme.Vgd.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
